<?xml version="1.0" encoding="utf-8"?>
<!-- Máy tính trong mạng nhà có thể chạy http (thiếu gói cryptography). https tự ký thì app ghim vân tay (Pin.kt). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
